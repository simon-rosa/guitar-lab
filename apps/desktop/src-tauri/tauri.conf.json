{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guitar Lab",
  "version": "0.4.1",
  "identifier": "fr.simonrosa.guitarlab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Guitar Lab",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Éditeur de tablatures et partitions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "glab"
        ],
        "name": "Morceau Guitar Lab",
        "role": "Editor",
        "mimeType": "application/vnd.guitarlab+json"
      },
      {
        "ext": [
          "gp",
          "gp5",
          "gp4",
          "gp3",
          "gpx"
        ],
        "name": "Guitar Pro",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "publisher": "Simon Rosa",
    "copyright": "© 2026 Simon Rosa"
  }
}
